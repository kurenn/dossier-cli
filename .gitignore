/dossier
/dist/
*.exe

# Generated by goreleaser's before-hooks, from the binary being released. Checking these
# in would create a second source of truth for the command tree that only updates when
# someone remembers to regenerate it.
/completions/

# Coverage
coverage.out
coverage.html

# The contract fixture: it holds live bearer tokens and raw recipient PINs, printed in the
# clear by `bin/rails cli:seed_contract`. Never commit it — it is regenerated per run, and
# in CI it is written into a checkout that is thrown away.
/testdata/contract.json

# Local tool state
.direnv/
